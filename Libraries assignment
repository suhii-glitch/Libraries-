-- Libraries: NumPy & Pandas Assignment Solution
-- Dataset: Retail Dataset

-- Q1. Load the given retail sales dataset into a Pandas DataFrame and display the first 5 rows
-- along with the dataset information to understand its structure.
-- Answer:
import pandas as pd

df = pd.read_csv("retail_dataset.csv")
print(df.head())
print(df.info())

-- Q2. Inspect the dataset and identify missing values in each column.
-- Display the total number of missing values present in the dataset.
-- Answer:
print(df.isnull().sum())
print("Total Missing Values:", df.isnull().sum().sum())

-- Q3. Replace missing values in the Quantity and Price columns with their respective mean values using Pandas.
-- Answer:
df['Quantity'].fillna(df['Quantity'].mean(), inplace=True)
df['Price'].fillna(df['Price'].mean(), inplace=True)

-- Q4. Remove all rows where the Product Category or Region column contains missing values.
-- Answer:
df.dropna(subset=['Product Category', 'Region'], inplace=True)

-- Q5. Create a new column called Revenue using NumPy, where:
-- Revenue = Quantity × Price
-- Display the updated dataset with the new column.
-- Answer:
import numpy as np

df['Revenue'] = np.multiply(df['Quantity'], df['Price'])
print(df.head())

-- Q6. Using NumPy, calculate the total revenue generated from all transactions in the dataset.
-- Answer:
total_revenue = np.sum(df['Revenue'])
print("Total Revenue:", total_revenue)

-- Q7. Group the dataset by Product Category and calculate the total revenue generated by each category.
-- Answer:
category_revenue = df.groupby('Product Category')['Revenue'].sum()
print(category_revenue)

-- Q8. Based on the revenue calculated for each product category, identify the top 3 categories
-- with the highest revenue and the bottom 3 categories with the lowest revenue.
-- Answer:
top_3 = category_revenue.sort_values(ascending=False).head(3)
bottom_3 = category_revenue.sort_values().head(3)

print("Top 3 Categories:")
print(top_3)

print("Bottom 3 Categories:")
print(bottom_3)

-- Q9. Group the dataset by Region and calculate the total revenue generated in each region.
-- Identify the region with the highest revenue and the region with the lowest revenue.
-- Answer:
region_revenue = df.groupby('Region')['Revenue'].sum()

highest_region = region_revenue.idxmax()
lowest_region = region_revenue.idxmin()

print(region_revenue)
print("Highest Revenue Region:", highest_region)
print("Lowest Revenue Region:", lowest_region)

-- Q10. Extract the month from the Date column using Pandas and group the dataset by month
-- to calculate the total monthly revenue. Also calculate mean, median, and standard deviation
-- of the Revenue column using NumPy.
-- Answer:
df['Date'] = pd.to_datetime(df['Date'])
df['Month'] = df['Date'].dt.month

monthly_revenue = df.groupby('Month')['Revenue'].sum()
print(monthly_revenue)

mean_revenue = np.mean(df['Revenue'])
median_revenue = np.median(df['Revenue'])
std_revenue = np.std(df['Revenue'])

print("Mean:", mean_revenue)
print("Median:", median_revenue)
print("Standard Deviation:", std_revenue)
